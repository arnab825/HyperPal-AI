# ==========================================
# ⚡ 1. GOOGLE GEMINI (DEFAULT / FREE BY HOST)
# ==========================================
# Provided by you so every user gets AI for free on your deployment!
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# 🚀 2. GROQ (OPEN-SOURCE LLAMA 3.3 & MIXTRAL)
# ==========================================
# Ultra-fast open-source inference (Llama 3.3 70B, Mixtral 8x7B)
# Get a free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ==========================================
# 🦙 3. LOCAL OLLAMA (100% PRIVATE & OFFLINE)
# ==========================================
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2
