# ==========================================
# ⚡ GOOGLE GEMINI API CONFIGURATION (RECOMMENDED)
# ==========================================
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Latest Gemini Model:
# - gemini-2.5-flash (Ultra-fast, high reasoning, latest)
# - gemini-1.5-flash
# - gemini-2.5-pro
VITE_GEMINI_MODEL=gemini-3.6-flash

# ==========================================
# OPTIONAL: OPENAI / GROQ / OPENROUTER
# ==========================================
VITE_OPENAI_API_KEY=
VITE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
VITE_AI_MODEL=minimaxai/minimax-m2.7
