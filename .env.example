# Optional: Provide your OpenAI, Groq, or OpenRouter API Key
# If left empty, HypePal AI works 100% offline with its built-in procedural AI engine!
VITE_OPENAI_API_KEY=

# Optional: Custom Endpoint (e.g. OpenAI, Groq, OpenRouter, Local Ollama)
VITE_AI_ENDPOINT=https://api.openai.com/v1/chat/completions

# Optional: Model Name (e.g. gpt-4o-mini, llama-3.3-70b-versatile)
VITE_AI_MODEL=gpt-4o-mini
